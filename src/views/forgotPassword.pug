extends base

block content
  .auth-page
    .auth-card
      .auth-card__brand
        a(href='/') 💡 Lumio
      h1.auth-card__title Forgot your password?
      p.auth-card__subtitle Enter your email and we'll send you a reset link.

      #alert-box

      .auth-form
        .form-group
          label(for='email') Email address
          input.form-input#email(type='email', placeholder='you@example.com', autocomplete='email', required)

        button.btn.btn--primary.btn--block#forgot-btn
          span Send Reset Link
          span.btn__spinner(hidden) ⏳

      .auth-card__footer
        p Remembered your password?
          a.form-link(href='/login')  Log in

block scripts
  script(src='/js/forgotPassword.js')
