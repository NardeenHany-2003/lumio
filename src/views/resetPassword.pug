extends base

block content
  .auth-page
    .auth-card
      .auth-card__brand
        a(href='/') 💡 Lumio
      h1.auth-card__title Choose a new password
      p.auth-card__subtitle Make it strong — at least 8 characters with uppercase, lowercase, and a number.

      #alert-box

      .auth-form
        .form-group
          label(for='password') New Password
          .input-wrapper
            input.form-input#password(type='password', placeholder='Min. 8 characters', autocomplete='new-password', required)
            button.input-toggle(type='button', data-target='password')
              i.bi.bi-eye

        .form-group
          label(for='passwordConfirm') Confirm Password
          .input-wrapper
            input.form-input#passwordConfirm(type='password', placeholder='Repeat your new password', autocomplete='new-password', required)
            button.input-toggle(type='button', data-target='passwordConfirm')
              i.bi.bi-eye

        button.btn.btn--primary.btn--block#reset-btn
          span Reset Password
          span.btn__spinner(hidden) ⏳

      .auth-card__footer
        p Remember it now?
          a.form-link(href='/login')  Log in

block scripts
  script(data-token=token src='/js/resetPassword.js')
