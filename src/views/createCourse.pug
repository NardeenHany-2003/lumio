extends base

block content
  .dashboard
    .dashboard__sidebar
      .dashboard__profile
        img.dashboard__avatar(src=`/img/${user.photo}`, alt=user.name)
        h3 #{user.name}
        span.badge.badge--role #{user.role}

      nav.dashboard__nav
        a.dashboard__nav-item(href='/dashboard')
          i.bi.bi-grid-1x2
          span  My Courses
        a.dashboard__nav-item.active(href='/courses/new')
          i.bi.bi-plus-circle
          span  New Course
        a.dashboard__nav-item(href='/profile')
          i.bi.bi-person
          span  Profile
        a.dashboard__nav-item(href='#', id='logout-btn')
          i.bi.bi-box-arrow-right
          span  Log Out

    .dashboard__main
      .dashboard__header
        h1.dashboard__title Create New Course

      .profile-card
        .profile-card__header
          h2.profile-card__title
            i.bi.bi-book
            |  Basic Information

        #course-alert

        .profile-form
          .form-group
            label(for='title') Course Title *
            input.form-input#title(
              type='text',
              placeholder='e.g. Complete Node.js Bootcamp',
              maxlength='120'
            )
            p.form-hint Between 5 and 120 characters.

          .form-group
            label(for='summary') Short Summary
            input.form-input#summary(
              type='text',
              placeholder='A one-line description shown on course cards…',
              maxlength='300'
            )

          .form-group
            label(for='description') Full Description *
            textarea.form-input#description(
              rows='5',
              placeholder='Describe what students will learn, who this is for, and what makes this course special… (min. 20 characters)',
              style='resize:vertical;',
              maxlength='2000'
            )

          .profile-form__row
            .form-group
              label(for='category') Category *
              select.form-input#category
                option(value='') — Select a category —
                each cat in categories
                  option(value=cat) #{cat}

            .form-group
              label(for='level') Level
              select.form-input#level
                each lvl in levels
                  option(value=lvl) #{lvl}

          .form-group
            label(for='price') Price (USD)
            input.form-input#price(
              type='number',
              placeholder='0',
              min='0',
              step='0.01',
              value='0'
            )
            p.form-hint Set to 0 for a free course.

          .form-group
            label(for='thumbnail') Course Thumbnail
            .thumbnail-upload-wrapper
              img#thumbnail-preview(
                src='/img/lumio-icon.png',
                alt='Thumbnail preview',
                style='width:160px;height:100px;object-fit:cover;border-radius:8px;border:2px solid var(--color-border);display:block;margin-bottom:.75rem;'
              )
              input.form-input#thumbnail(type='file', accept='image/jpeg,image/png,image/webp')
            p.form-hint JPG, PNG or WebP · Max 5MB · Recommended 1280×720

      .profile-card
        .profile-card__header
          h2.profile-card__title
            i.bi.bi-list-check
            |  What Students Will Learn

        .profile-form
          .form-group
            label What You'll Learn
            p.form-hint Add the key outcomes students will achieve. Press Enter or click + to add each one.
            .dynamic-list#learn-list
            .dynamic-list__input-row
              input.form-input#learn-input(type='text', placeholder='e.g. Build REST APIs with Node.js and Express')
              button.btn.btn--primary.btn--sm#learn-add-btn(type='button')
                i.bi.bi-plus-lg

          .form-group
            label Requirements
            p.form-hint What should students already know before taking this course?
            .dynamic-list#req-list
            .dynamic-list__input-row
              input.form-input#req-input(type='text', placeholder='e.g. Basic JavaScript knowledge')
              button.btn.btn--primary.btn--sm#req-add-btn(type='button')
                i.bi.bi-plus-lg

          .form-group
            label Tags
            p.form-hint Add searchable tags (max 10). Press Enter or click +.
            .dynamic-list#tags-list
            .dynamic-list__input-row
              input.form-input#tags-input(type='text', placeholder='e.g. nodejs, express, mongodb')
              button.btn.btn--primary.btn--sm#tags-add-btn(type='button')
                i.bi.bi-plus-lg

      .profile-card
        .profile-card__header
          h2.profile-card__title
            i.bi.bi-camera-video
            |  Lessons
          p(style='color:var(--color-text-muted);font-size:.88rem;margin-top:.35rem;')
            | Add your lessons now, or add them later from the course dashboard.

        #lessons-container
          p.loading-text.lessons-empty-hint No lessons added yet.

        .lesson-add-form
          h3(style='font-size:1rem;font-weight:700;margin-bottom:1rem;')
            i.bi.bi-plus-circle(style='color:var(--color-primary);margin-right:.4rem;')
            | Add a Lesson

          .profile-form
            .profile-form__row
              .form-group
                label(for='lesson-title') Lesson Title *
                input.form-input#lesson-title(type='text', placeholder='e.g. Introduction to Node.js', maxlength='150')

              .form-group
                label(for='lesson-duration') Duration (minutes)
                input.form-input#lesson-duration(type='number', placeholder='e.g. 25', min='0', value='0')

            .form-group
              label(for='lesson-video') Lesson Video
              input.form-input#lesson-video(type='file', accept='video/mp4,video/webm,video/ogg,video/quicktime')
              p.form-hint MP4, WebM, or MOV · Max 500MB

            .form-group
              label(for='lesson-content') Lesson Notes
              textarea.form-input#lesson-content(rows='3', placeholder='Optional text content…', style='resize:vertical;')

            .profile-form__row
              .form-group
                label(for='lesson-order') Order
                input.form-input#lesson-order(type='number', min='0', value='1')

              .form-group
                label &nbsp;
                label(for='lesson-is-free', style='display:flex;align-items:center;gap:.5rem;cursor:pointer;padding:.6rem .9rem;border:1.5px solid var(--color-border);border-radius:var(--radius-sm);font-weight:600;font-size:.9rem;')
                  input(type='checkbox', id='lesson-is-free', style='width:16px;height:16px;accent-color:var(--color-primary);')
                  i.bi.bi-unlock
                  span  Free Preview

            button.btn.btn--primary#add-lesson-btn(type='button')
              i.bi.bi-plus-lg
              span  Add Lesson

      .profile-card
        .profile-card__header
          h2.profile-card__title
            i.bi.bi-rocket-takeoff
            |  Publish

        .profile-form
          .form-group
            label Visibility
            .role-toggle
              input(type='radio', name='publish', id='pub-draft', value='false', checked)
              label.role-toggle__option(for='pub-draft')
                i.bi.bi-file-earmark
                span  Save as Draft
              input(type='radio', name='publish', id='pub-live', value='true')
              label.role-toggle__option(for='pub-live')
                i.bi.bi-globe
                span  Publish Now

          .form-group(style='display:flex; gap:1rem; margin-top:.5rem;')
            button.btn.btn--primary#create-course-submit-btn
              i.bi.bi-check-lg
              span  Create Course
            a.btn.btn--ghost(href='/dashboard') Cancel

block scripts
  script(src='/js/createCourse.js')