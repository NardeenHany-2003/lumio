extends baseEmail

block content
  h1 Forgot your password?
  p Hi #{firstName},
  p We received a request to reset the password for your Lumio account. Click the button below — this link is only valid for <strong>10 minutes</strong>.
  a.email-btn(href=url) Reset My Password
  hr.email-divider
  p.email-small
    | If the button doesn't work, copy and paste this link into your browser:
    br
    a(href=url style='color:#6c47ff') #{url}
  p.email-small If you didn't request a password reset, no action is needed — your password will remain unchanged.
