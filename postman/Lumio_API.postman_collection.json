                "exec": [
                  "if(pm.response.code===201){const d=pm.response.json();pm.collectionVariables.set('accessToken',d.accessToken);pm.collectionVariables.set('refreshToken',d.refreshToken);pm.collectionVariables.set('userId',d.data.user._id);}"
                ],
                "type": "text/javascript"
              }
            }
          ],
